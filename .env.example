# Postgres connection string (Neon, Supabase, Vercel Postgres, or local)
DATABASE_URL=postgres://user:password@host:5432/db

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=

# Sign-in providers. Configure at least one.
# Discord: https://discord.com/developers/applications  (redirect: <site>/api/auth/callback/discord)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Google: https://console.cloud.google.com/apis/credentials  (redirect: <site>/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# MarvelRivalsAPI.com key for playtime sync (server-side only, never exposed to the browser)
MARVEL_RIVALS_API_KEY=
# Who sees playtime sync once the key is set: off, admin (ADMIN_EMAILS accounts only) or on (everyone). Default admin.
# FEATURE_PLAYTIME_SYNC=admin

# Anthropic API key for screenshot import (server-side only). Without it the import is hidden.
ANTHROPIC_API_KEY=
# Optional: model for reading screenshots (default claude-opus-5-5, the only one that read every badge correctly)
# SCREENSHOT_MODEL=

# Sign-in emails allowed to open /stats (comma separated)
ADMIN_EMAILS=

# Optional: connection pool size per server instance (default 5)
# DB_POOL_MAX=5
