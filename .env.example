# Postgres connection string (Neon, Supabase, Vercel Postgres, or local)
DATABASE_URL=postgres://user:password@host:5432/db

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=

# Sign-in providers. Configure at least one.
# Discord: https://discord.com/developers/applications  (redirect: <site>/api/auth/callback/discord)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Google: https://console.cloud.google.com/apis/credentials  (redirect: <site>/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# MarvelRivalsAPI.com key for playtime sync (server-side only, never exposed to the browser)
MARVEL_RIVALS_API_KEY=

# Optional: connection pool size per server instance (default 5)
# DB_POOL_MAX=5
